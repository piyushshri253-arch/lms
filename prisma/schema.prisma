  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  url             String
  thumbnailUrl    String?
  data            String?       @db.Text
  type            String        // IMAGE, VIDEO, DOCUMENT, PDF
  provider        String        @default("LOCAL") // DIRECT_UPLOAD, S3, CLOUDINARY, YOUTUBE, VIMEO, HLS_STREAM, CDN_STORAGE, EXTERNAL_URL
  format          String?       // mp4, webm, mov, m3u8, etc.
  sizeBytes       Int           @default(0)
  durationSeconds Int           @default(0)
  durationText    String        @default("10:00")
  status          String        @default("READY") // UPLOADING, PROCESSING, READY, FAILED
  uploadedBy      String?
  uploadedByUser  String?
  courseId        String?
  lessonId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
