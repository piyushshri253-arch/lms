  netAmount       Float
  currency        String                 @default("INR")
  payoutMethod    String                 @default("BANK_TRANSFER") // BANK_TRANSFER, UPI
  status          String                 @default("REQUESTED") // REQUESTED, PENDING, APPROVED, PROCESSING, PAID, REJECTED, FAILED, CANCELLED
  referenceNumber String?
  rejectionReason String?
  adminNotes      String?
  processedById   String?
  processedByName String?
  requestedAt     DateTime               @default(now())
  processedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId])
  @@index([status])
}

model InstructorEarningTransaction {
  id              String   @id @default(cuid())
  transactionRef  String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  courseTitle     String?
  studentId       String?
  studentName     String?
  studentEmail    String?
  type            String   @default("COURSE_SALE") // COURSE_SALE, PAYOUT, REFUND, ADJUSTMENT
  grossAmount     Float
  platformFee     Float    @default(0.0)
  instructorShare Float
  taxDeduction    Float    @default(0.0)
  netAmount       Float
  paymentMethod   String   @default("RAZORPAY")
  status          String   @default("PAID") // PENDING, PROCESSING, PAID, FAILED, CANCELLED, REFUNDED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

