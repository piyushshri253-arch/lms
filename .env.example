# ==============================================================================
# MORENA TEACH LMS & SALES PLATFORM - VERCEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE (Required for Vercel)
# Use a cloud PostgreSQL provider like Neon (neon.tech) or Supabase (supabase.com)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# 2. SECURITY & SESSIONS (Required)
# Generate a strong 32+ character string (e.g. using `openssl rand -hex 32`)
JWT_SECRET="morena-teach-production-secure-jwt-key-change-this-in-production-2026"
ENCRYPTION_SECRET="morena-teach-production-32-char-encryption-key-here"
MEDIA_SIGNING_SECRET="morena-teach-production-media-signing-secret"

# 3. PUBLIC APP URL (Required)
# Set this to your Vercel deployment domain or custom domain
NEXT_PUBLIC_APP_URL="https://your-lms.vercel.app"

# 4. EMAIL SERVICE (Optional / Recommended)
# Set EMAIL_SIMULATE to "true" to print OTPs in Vercel runtime logs without real SMTP,
# or set to "false" and provide real SMTP credentials below.
EMAIL_SIMULATE="false"
EMAIL_FROM="morena@morenateach.com"
EMAIL_FROM_NAME="Morena Teach"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# 5. WHATSAPP NOTIFICATIONS (Optional)
# WHATSAPP_API_KEY=""
# WHATSAPP_PHONE_NUMBER_ID=""
